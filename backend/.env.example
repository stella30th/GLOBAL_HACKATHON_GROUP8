# Copy this file to .env (or export these as real environment variables) and fill in the values
# for your setup. Nothing here is read directly from a .env file by Spring Boot itself; how you
# get these into the process's environment (a .env loader, your shell, Docker, Render's dashboard)
# is up to your setup. Defaults shown after each ":" in application.yaml are what you get if a
# variable is left unset.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# MySQL connection used outside the "local" Spring profile (docker-compose / Render). The local
# profile (./mvnw spring-boot:run -Dspring-boot.run.profiles=local) ignores all of this and uses
# an embedded H2 file database instead.
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3308/aicareer_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DATABASE_USERNAME=root
DATABASE_PASSWORD=rootpassword
# Usually left unset; Spring Boot auto-detects the driver from the JDBC URL.
DATABASE_DRIVER=

# ---------------------------------------------------------------------------
# Session cookie (per-user scoping - keeps one visitor's profile/CV separate from another's)
# ---------------------------------------------------------------------------
# Deployed setup (frontend and API on different origins) needs both Secure and SameSite=None, or
# the browser will not attach the cookie at all. The "local" profile already turns these off.
APP_SESSION_COOKIE_SECURE=true
APP_SESSION_COOKIE_SAME_SITE=None
APP_SESSION_COOKIE_MAX_AGE_DAYS=180

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Exact origin(s) of the deployed frontend, comma-separated. Never a wildcard: requests carry the
# session cookie, so reflecting any origin would let any page on the internet call this API as a
# signed-in visitor.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Admin token - REQUIRED for the SFIA admin/reload endpoints to work at all
# ---------------------------------------------------------------------------
# Shared secret behind every operator action that replaces reference data everyone's requests
# read: POST /api/admin/sfia/upload, POST /api/admin/sfia/reload, and
# POST /api/plan/data-status/reload. Sent back as the "X-Admin-Token" request header.
#
# Unset means those three endpoints refuse every request (503 "Admin endpoints are disabled"),
# not that they fall open - so this must be set in every environment where you intend to use them,
# including Render.
#
# Generate one long random value, e.g.: openssl rand -hex 32
ADMIN_TOKEN=

# ---------------------------------------------------------------------------
# Gemini
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
# Exactly two models are ever contacted. Flash-Lite is primary by default because Gemini 3.5
# Flash's free-tier daily quota (~20 requests/day/project) is exhausted by about five plan
# generations (4 calls each); swap the two values below to follow the original primary/fallback
# order exactly, no code change needed.
GEMINI_PRIMARY_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_ATTEMPTS=2
AI_MAX_REPAIR_ATTEMPTS=2

# ---------------------------------------------------------------------------
# SFIA 9 taxonomy loading (this pass's subject - see the "SFIA 9" section of README.md)
# ---------------------------------------------------------------------------
# Local folder scanned for a .xlsx workbook, at the folder itself or one level of subfolder (the
# per-language subfolders the official download unzips into: "SFIA 9 Excel - English/", etc).
# Gitignored by default so a licensed copy can't be committed by accident.
SFIA_DATA_DIR=./data/sfia

# The durable path for a container whose filesystem does not survive a restart/redeploy/cold
# start (this includes Render). Fetched at start-up only when no usable local file exists, and
# always fetched fresh on a manual reload (POST /api/admin/sfia/reload or
# POST /api/plan/data-status/reload). Leave both SFIA_SOURCE_URL and SFIA_SOURCE_TOKEN unset for
# local development if you just drop the workbook into SFIA_DATA_DIR by hand.
#
# Documented default: a private GitHub release asset, fetched via the GitHub REST API -
#   https://api.github.com/repos/<owner>/<repo>/releases/assets/<asset_id>
# See the "SFIA 9" section of README.md for the full step-by-step runbook (uploading the asset,
# finding its asset id, generating the token). Any other host that returns the raw .xlsx bytes for
# a GET request with an Authorization: Bearer header works too - this is not GitHub-specific code.
SFIA_SOURCE_URL=
# Sent as "Authorization: Bearer <this value>", but only to the host/port in SFIA_SOURCE_URL -
# never forwarded to a different host if the source redirects. For the GitHub default, this is a
# fine-grained personal access token with read-only access to the release asset. Never logged.
SFIA_SOURCE_TOKEN=
SFIA_DOWNLOAD_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# Retrieval / resource catalogue
# ---------------------------------------------------------------------------
# Checking every catalogued URL adds about a minute to start-up. Off by default; trigger it
# on demand with POST /api/plan/data-status/verify-urls instead.
RETRIEVAL_VERIFY_URLS=false
RETRIEVAL_URL_TIMEOUT=6

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
# HTTP port. Render sets this itself; leave unset locally to use 8080.
PORT=8080
